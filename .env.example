# ──────────────────────────────────────────────
# SMTP – sending emails
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Lootdrop
SMTP_FROM_EMAIL=your@gmail.com
SMTP_USE_TLS=true

# ──────────────────────────────────────────────
# Admin panel
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
# Always set a strong password
ADMIN_PASSWORD=change-this-password

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
# Long random string for signing sessions, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Public base URL (used for unsubscribe links in emails)
BASE_URL=http://localhost:8000

# Path to the SQLite database file (in the container: /data/lootdrop.db)
DATABASE_PATH=/data/lootdrop.db

# ──────────────────────────────────────────────
# Scheduler – initial daily email time (UTC)
# Can be changed later in the admin panel.
# ──────────────────────────────────────────────
EMAIL_HOUR=18
EMAIL_MINUTE=0
