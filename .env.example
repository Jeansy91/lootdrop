# ──────────────────────────────────────────────
# SMTP – E-Mail-Versand
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Free Games
SMTP_FROM_EMAIL=your@gmail.com
SMTP_USE_TLS=true

# ──────────────────────────────────────────────
# Admin-Panel
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
# Langer, zufälliger String für Session-Signaturen
SECRET_KEY=change-this-to-a-long-random-secret-string

# Öffentliche Basis-URL (für Abmelde-Links in E-Mails)
BASE_URL=http://localhost:8000

# Pfad zur SQLite-Datenbankdatei (im Container: /data/freegames.db)
DATABASE_PATH=/data/freegames.db

# ──────────────────────────────────────────────
# Scheduler – täglicher E-Mail-Versand (UTC)
# ──────────────────────────────────────────────
EMAIL_HOUR=9
EMAIL_MINUTE=0
